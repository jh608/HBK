"\t\t\tendif\n"
"\t\t\t%printf(\"HF Transformer core material = 2605SA1, 100C\\n  Intial Perma"
"tivity=%d,\\n  Saturated Permativity=%d,\\n  Saturation Flux Density=%d,\\n  "
"Remanance Flux Density=%d,\\n  Saturation Field Strength=%d\\n  Coercive Fiel"
"d Strength=%d,\\n\", u_i, u_s, B_s, B_r, H_s, H_c);\n"
"\t\tendif\n"
"\totherwise\n"
"\t\terror('Invalid Material Type (Using N97)')\n"
"\t\t\tu_i = 2300;\n"
"\t\t\tu_s = 1;\n"
"\t\t\tB_s = 0.510;\n"
"\t\t\tB_r = 0.24;\n"
"\t\t\tH_s = 1200;\n"
"\t\t\tH_c = 21;\n"
"\t\t\tif ((Configuration == 3) && (H_c/H_s < 0.05))\n"
"\t\t\t\tH_s = H_c/0.05;\n"
"\t\t\t\tplecs('warning', 'H_s set to H_c/0.05 to meet condition: H_c/H_sat >="
" 0.05');\n"
"\t\t\tendif\n"
"endswitch \t\t\t\t\t\t\t% material\n"
"\n"
"switch (shape) \t\t\t\t\t% Set core shape parameters \n"
"\tcase 1 \t\t\t\t\t\t\t% EELP 102/20/38 (https://product.tdk.com/system/files"
"/dam/doc/product/ferrite/ferrite/ferrite-core/data_sheet/80/db/fer/elp_102_20"
"_38.pdf)\n"
"\t\tAe\t\t=\t538e-6; \t\t\t% Effective area in meters squared\n"
"\t\tAmin\t=  524.5e-6;\t\t% Minimum area in meters squared\n"
"\t\tle \t=\t147.6e-3;\t\t% Effective magnetic path length in meters \n"
"\t\tVe \t= \t79410e-9;\t\t% Effective magnetic volume in meters cubed\n"
"\t\tmin_lg=  1.5395e-5;\t\t% minimum air gap = le(1/ds_ue - 1/ui) where ds_ue"
" = data sheet ue\n"
"\t\tcdl\t= \t102e-3;\t   \t% Core length\n"
"\t\tcdh\t= \t20.3e-3 * 2;\t% Core height (set)\n"
"\t\tcdd\t= \t37.5e-3;\t  \t\t% Core depth\n"
"\t\tcdlw\t= \t14.0e-3;\t  \t\t% Core centre leg width\n"
"\t\tWh   \t= \tcdh-cdlw; \t\t% Winding window height \n"
"\t\tWw \t= \t(cdl/2)-cdlw;\t% Winding window width\n"
"\t\tWa \t= \tWh*Ww; \t\t\t% Winding Window area\n"
"\t\t%printf(\"HF Transformer core shape = EELP 102/20/38\\n  Effective magnet"
"ic crossection area=%dm^2,\\n  Minimum magnetic crossection area=%dm^2,\\n  E"
"ffective magnetic path length=%dm,\\n  Effective magnetic volume=%dm^3,\\n  M"
"inimum Air Gap=%dm,\\n  Core Length=%dm,\\n  Core Height=%dm,\\n  Core Depth="
"%dm,\\n  Core Leg Width=%dm,\\n  Winding window height=%dm,\\n  Winding windo"
"w width=%dm,\\n  Winding window area=%dm^2\\n\", Ae, Amin, le, Ve, min_lg, cd"
"l, cdh, cdd, cdlw, Wh, Ww, Wa);\n"
"\tcase 2 \t\t\t\t\t\t\t% EILP 102/20/38 (https://product.tdk.com/system/files"
"/dam/doc/product/ferrite/ferrite/ferrite-core/data_sheet/80/db/fer/elp_102_20"
"_38.pdf)\n"
"\t\tAe\t\t=\t534.2e-6; \t\t% Effective area in meters squared\n"
"\t\tAmin\t=  524.5e-6;\t\t% Minimum area in meters squared\n"
"\t\tle \t=\t121.2e-3;\t\t% Effective magnetic path length in meters \n"
"\t\tVe \t= \t67745e-9;\t\t% Effective magnetic volume in meters cubed\n"
"\t\tmin_lg=  1.69595e-5;\t\t% minimum air gap = le(1/ds_ue - 1/ui) where ds_u"
"e = data sheet ue\n"
"\t\tcdl\t= \t102e-3;\t   \t% Core length\n"
"\t\tcdh\t= \t20.3e-3 * 2;\t% Core height (set)\n"
"\t\tcdd\t= \t37.5e-3;\t  \t\t% Core depth\n"
"\t\tcdlw\t= \t14.0e-3;\t  \t\t% Core centre leg width\n"
"\t\tWh   \t= \tcdh-cdlw; \t\t% Winding window height \n"
"\t\tWw \t= \t(cdl/2)-cdlw;\t% Winding window width\n"
"\t\tWa \t= \tWh*Ww; \t\t\t% Winding Window area\n"
"\t\t%printf(\"HF Transformer core shape = EILP 102/20/38\\n  Effective magnet"
"ic crossection area=%dm^2,\\n  Minimum magnetic crossection area=%dm^2,\\n  E"
"ffective magnetic path length=%dm,\\n  Effective magnetic volume=%dm^3,\\n  M"
"inimum Air Gap=%dm,\\n  Core Length=%dm,\\n  Core Height=%dm,\\n  Core Depth="
"%dm,\\n  Core Leg Width=%dm,\\n  Winding window height=%dm,\\n  Winding windo"
"w width=%dm,\\n  Winding window area=%dm^2\\n\", Ae, Amin, le, Ve, min_lg, cd"
"l, cdh, cdd, cdlw, Wh, Ww, Wa);\n"
"\tcase 3 \t\t\t\t\t\t\t% EE 100/60/28 (https://product.tdk.com/system/files/d"
"am/doc/product/ferrite/ferrite/ferrite-core/data_sheet/80/db/fer/e_100_60_28."
"pdf)\n"
"\t\tAe\t\t=\t735e-6; \t\t\t% Effective area in meters squared\n"
"\t\tAmin\t=  690e-6;\t\t\t% Minimum area in meters squared\n"
"\t\tle \t=\t274e-3;\t\t\t% Effective magnetic path length in meters \n"
"\t\tVe \t= \t201390e-9;\t\t% Effective magnetic volume in meters cubed\n"
"\t\tmin_lg=  1.65131e-5;\t\t% minimum air gap = le(1/ds_ue - 1/ui) where ds_u"
"e = data sheet ue\n"
"\t\tcdl\t= \t100.3e-3;\t\t% Core length\n"
"\t\tcdh\t= \t59.4e-3 * 2;\t% Core height (set)\n"
"\t\tcdd\t= \t27.5e-3;\t  \t\t% Core depth\n"
"\t\tcdlw\t= \t27.5e-3;\t  \t\t% Core centre leg width\n"
"\t\tWh   \t= \tcdh-cdlw; \t\t% Winding window height \n"
"\t\tWw \t= \t(cdl/2)-cdlw;\t% Winding window width\n"
"\t\tWa \t= \tWh*Ww; \t\t\t% Winding Window area\n"
"\t\t%printf(\"HF Transformer core shape = EE 100/60/28\\n  Effective magnetic"
" crossection area=%dm^2,\\n  Minimum magnetic crossection area=%dm^2,\\n  Eff"
"ective magnetic path length=%dm,\\n  Effective magnetic volume=%dm^3,\\n  Min"
"imum Air Gap=%dm,\\n  Core Length=%dm,\\n  Core Height=%dm,\\n  Core Depth=%d"
"m,\\n  Core Leg Width=%dm,\\n  Winding window height=%dm,\\n  Winding window "
"width=%dm,\\n  Winding window area=%dm^2\\n\", Ae, Amin, le, Ve, min_lg, cdl,"
" cdh, cdd, cdlw, Wh, Ww, Wa);\n"
"\tcase 4 \t\t\t\t\t\t\t% AMCC-10  (https://www.mouser.co.uk/datasheet/2/957/h"
"j_b11_a-1509989.pdf)\n"
"\t\tAe\t\t=\t180e-6; \t\t\t% Effective area in meters squared\n"
"\t\tAmin\t=  180e-6;\t\t\t% Minimum area in meters squared\n"
"\t\tle \t=\t150e-3;\t\t\t% Effective magnetic path length in meters \n"
"\t\tVe \t= \t201390e-9;\t\t% Effective magnetic volume in meters cubed\n"
"\t\tmin_lg=  1.65131e-5;\t\t% minimum air gap = le(1/ds_ue - 1/ui) where ds_u"
"e = data sheet ue\n"
"\t\tcdl\t= \t35e-3;\t\t\t% Core length\n"
"\t\tcdh\t= \t31e-3 * 2;\t\t% Core height (set)\n"
"\t\tcdd\t= \t20e-3;\t  \t\t% Core depth\n"
"\t\tcdlw\t= \t11e-3;\t  \t\t% Core centre leg width\n"
"\t\tWh   \t= \tcdl - cdlw*2;\t% Winding window height \n"
"\t\tWw \t= \tcdh - cdlw*2;\t% Winding window width\n"
"\t\tWa \t= \tWh*Ww; \t\t\t% Winding Window area\n"
"\t\t%printf(\"HF Transformer core shape = AMCC-10\\n  Effective magnetic cros"
"section area=%dm^2,\\n  Minimum magnetic crossection area=%dm^2,\\n  Effectiv"
"e magnetic path length=%dm,\\n  Effective magnetic volume=%dm^3,\\n  Minimum "
"Air Gap=%dm,\\n  Core Length=%dm,\\n  Core Height=%dm,\\n  Core Depth=%dm,\\n"
"  Core Leg Width=%dm,\\n  Winding window height=%dm,\\n  Winding window width"
"=%dm,\\n  Winding window area=%dm^2\\n\", Ae, Amin, le, Ve, min_lg, cdl, cdh,"
" cdd, cdlw, Wh, Ww, Wa);\n"
"\tcase 4 \t\t\t\t\t\t\t% AMCC-20  (https://www.mouser.co.uk/datasheet/2/957/h"
"j_b11_a-1509989.pdf)\n"
"\t\tAe\t\t=\t271e-6; \t\t\t% Effective area in meters squared\n"
"\t\tAmin\t=  271e-6;\t\t\t% Minimum area in meters squared\n"
"\t\tle \t=\t170e-3;\t\t\t% Effective magnetic path length in meters \n"
"\t\tVe \t= \t201390e-9;\t\t% Effective magnetic volume in meters cubed\n"
"\t\tmin_lg=  1.65131e-5;\t\t% minimum air gap = le(1/ds_ue - 1/ui) where ds_u"
"e = data sheet ue\n"
"\t\tcdl\t= \t35e-3;\t\t\t% Core length\n"
"\t\tcdh\t= \t36e-3 * 2;\t\t% Core height (set)\n"
"\t\tcdd\t= \t30e-3;\t  \t\t% Core depth\n"
"\t\tcdlw\t= \t11e-3;\t  \t\t% Core centre leg width\n"
"\t\tWh   \t= \tcdl - cdlw*2;\t% Winding window height \n"
"\t\tWw \t= \tcdh - cdlw*2;\t% Winding window width\n"
"\t\tWa \t= \tWh*Ww; \t\t\t% Winding Window area\n"
"\t\t%printf(\"HF Transformer core shape = AMCC-20\\n  Effective magnetic cros"
"section area=%dm^2,\\n  Minimum magnetic crossection area=%dm^2,\\n  Effectiv"
"e magnetic path length=%dm,\\n  Effective magnetic volume=%dm^3,\\n  Minimum "
"Air Gap=%dm,\\n  Core Length=%dm,\\n  Core Height=%dm,\\n  Core Depth=%dm,\\n"
"  Core Leg Width=%dm,\\n  Winding window height=%dm,\\n  Winding window width"
"=%dm,\\n  Winding window area=%dm^2\\n\", Ae, Amin, le, Ve, min_lg, cdl, cdh,"
" cdd, cdlw, Wh, Ww, Wa);\n"
"\tcase 6 \t\t\t\t\t\t\t% AMCC-50  (https://www.mouser.co.uk/datasheet/2/957/h"
"j_b11_a-1509989.pdf)\n"
"\t\tAe\t\t=\t328e-6; \t\t\t% Effective area in meters squared\n"
"\t\tAmin\t=  328e-6;\t\t\t% Minimum area in meters squared\n"
"\t\tle \t=\t244e-3;\t\t\t% Effective magnetic path length in meters \n"
"\t\tVe \t= \t201390e-9;\t\t% Effective magnetic volume in meters cubed\n"
"\t\tmin_lg=  1.65131e-5;\t\t% minimum air gap = le(1/ds_ue - 1/ui) where ds_u"
"e = data sheet ue\n"
"\t\tcdl\t= \t52e-3;\t\t\t% Core length\n"
"\t\tcdh\t= \t51e-3 * 2;\t\t% Core height (set)\n"
"\t\tcdd\t= \t25e-3;\t  \t\t% Core depth\n"
"\t\tcdlw\t= \t16e-3;\t  \t\t% Core centre leg width\n"
"\t\tWh   \t= \tcdl - cdlw*2;\t% Winding window height \n"
"\t\tWw \t= \tcdh - cdlw*2;\t% Winding window width\n"
"\t\tWa \t= \tWh*Ww; \t\t\t% Winding Window area\n"
"\t\t%printf(\"HF Transformer core shape = AMCC-50\\n  Effective magnetic cros"
"section area=%dm^2,\\n  Minimum magnetic crossection area=%dm^2,\\n  Effectiv"
"e magnetic path length=%dm,\\n  Effective magnetic volume=%dm^3,\\n  Minimum "
"Air Gap=%dm,\\n  Core Length=%dm,\\n  Core Height=%dm,\\n  Core Depth=%dm,\\n"
"  Core Leg Width=%dm,\\n  Winding window height=%dm,\\n  Winding window width"
"=%dm,\\n  Winding window area=%dm^2\\n\", Ae, Amin, le, Ve, min_lg, cdl, cdh,"
" cdd, cdlw, Wh, Ww, Wa);\n"
"endswitch \t\t\t\t\t\t\t% shape\n"
"\n"
"% Calculate electrical/magnetic parameters from core material, shape and wind"
"ings\n"
"%printf(\"HF Transformer calculated parameters\\n\");\n"
"% Effective permativity u_e\n"
"% first we need the effective air gap lge\n"
"if (lg >= min_lg)\n"
"\tlge \t\t= lg;\n"
"else\n"
"\tlge \t\t= min_lg;\n"
"endif\n"
"%printf(\"  Effective air gap = %dm\\n\",lge);\n"
"% Total efective core area\n"
"Ae_total \t= Ae * coreCount;\n"
"%printf(\"  Total effective core area = %dm^2\\n\",Ae_total);\n"
"% Now effective permativity\n"
"u_e \t\t\t= ( u_i * le ) / ( le + ( lge * u_i ));\n"
"%printf(\"  Effective permativity = %d\\n\",u_e);\n"
"% Calculate Inductance Factor (AL)\n"
"AL \t\t\t= ( u0 * u_e * Ae_total ) / le;\n"
"%printf(\"  Inductance Factor = %d\\n\",AL);\n"
"% From AL we and calculae Lm\n"
"if ((isnan(Lm)) || (Configuration != 1))\n"
"\tLm \t\t= (n_pri^2) * AL;\n"
"endif\n"
"%printf(\"  Magnetizing Inductance = %d\\n\",Lm);\n"
"% Calculate Mean Length Turn\n"
"MLTwire \t\t= 2*((cdd*coreCount) + cdlw) + (Ww*(2 + pi));\n"
"MLTplanar \t= 2*cdlw + 2*Ww + 2.82*cdd*coreCount;\n"
"% Calculate winding resistance\n"
"% Skin Depth (m)\n"
"skinDepth   = sqrt(1.68e-8/(pi*fsw*pi*4e-7*0.99994));\n"
"% printf(\"  skinDepth = %d\\n\",skinDepth);\n"
"% Litz Wire diameter (m)\n"
"Lwdp \t\t\t= 0.000127 * (92^((36-litzWireAwp)/39));\n"
"Lwds \t\t\t= 0.000127 * (92^((36-litzWireAws)/39));\n"
"% printf(\"  Lwdp = %d\\n\",Lwdp);\n"
"% printf(\"  Lwds = %d\\n\",Lwds);\n"
"% Litz wire strand area (m^2)\n"
"LwAsp \t\t= pi * (Lwdp/2)^2;\n"
"LwAss \t\t= pi * (Lwds/2)^2;\n"
"% Litz wire area (m^2)\n"
"LwAp \t\t\t= LwAsp * LwSp * LwKbw;\n"
"LwAs \t\t\t= LwAss * LwSs * LwKbw;\n"
"% printf(\"  LwAp = %d\\n\",LwAp);\n"
"% printf(\"  LwAs = %d\\n\",LwAs);\n"
"% Litz wire overall diameter\n"
"LwODp \t\t= 1.29*sqrt(LwSp)*Lwdp*(1/LwKuf);\n"
"LwODs \t\t= 1.29*sqrt(LwSs)*Lwds*(1/LwKuf);\n"
"%printf(\"  Litz wire outside diameter primary = %d\\n\",LwODp);\n"
"%printf(\"  Litz wire outside diameter secondary = %d\\n\",LwODs);\n"
"% Planar Trace Thcikness (m)\n"
"Pwt \t\t\t= Pww * 0.0000348;\n"
"% Planar Trace Area (m^2)\n"
"PwAp \t\t\t= Pwt * Pwtwp;\n"
"PwAs \t\t\t= Pwt * Pwtws;\n"
"% printf(\"  PwAp = %d\\n\",PwAp);\n"
"% printf(\"  PwAs = %d\\n\",PwAs);\n"
"switch (winding)\n"
"\tcase 1\n"
"\t\tMLT \t= MLTwire;\n"
"\t\tWAp \t= LwAp;\n"
"\t\tWAs \t= LwAs;\n"
"\t\tb \t\t= Ww;\n"
"\t\tap \t= ceil(n_pri/floor(Ww/LwODp))*LwODp;\n"
"\t\tas \t= ceil(n_sec/floor(Ww/LwODs))*LwODs;\n"
"\t\tc \t\t= Wh-ap-as;\n"
"\t\tif (c <= 0)\n"
"\t\t\tc \t= 0;\n"
"\t\t\tplecs('warning', 'Windings will not fit in chosen core, winding insulat"
"ion gap <= 0');\n"
"\t\telse if (c >= cMax)\n"
"\t\t\t\tc = cMax;\n"
"\t\t\t\tplecs('warning', 'Winding insulation gap >= Max set, set to maximum')"
";\n"
"\t\t\tendif\n"
"\t\tendif\n"
"\t\t% Leakage Inductance\n"
"\t\tif ((isnan(Lp)) || (Configuration != 1))\n"
"\t\t\tLp\t\t\t= ((4*pi*(MLT*100)*(n_pri^2))/(b*100))*((c*100)+(((ap*100)+(as*"
"100))/3))*1e-9;\n"
"\t\tendif\n"
"\t\tif ((isnan(Ls)) || (Configuration != 1))\n"
"\t\t\tLs\t\t\t= ((4*pi*(MLT*100)*(n_sec^2))/(b*100))*((c*100)+(((ap*100)+(as*"
"100))/3))*1e-9;\t\n"
"\t\tendif\n"
"\t\t% WInding to Winding capacitance\n"
"\t\tif ((isnan(Cps)) || (Configuration != 1))\n"
"\t\t\tCps \t\t= (e0*er_air*IwEr*b*MLT)/((c*er_air)+(Iwl*IwEr)) ;\n"
"\t\tendif\n"
"\tcase 2\n"
"\t\tMLT \t= MLTwire;\n"
"\t\tWAp \t= LwAp;\n"
"\t\tWAs \t= LwAs;\n"
"\t\tb \t\t= Wh;\n"
"\t\tap \t= ceil(n_pri/floor(Wh/LwODp))*LwODp;\n"
"\t\tas \t= ceil(n_sec/floor(Wh/LwODs))*LwODs;\n"
"\t\tc \t\t= Ww-ap-as;\n"
"\t\tif (c <= 0)\n"
"\t\t\tc \t= 0;\n"
"\t\t\tplecs('warning', 'Windings will not fit in chosen core, winding insulat"
"ion gap <= 0');\n"
"\t\telse if (c >= cMax)\n"
"\t\t\t\tc = cMax;\n"
"\t\t\t\tplecs('warning', 'Winding insulation gap >= Max set, set to maximum')"
";\n"
"\t\t\tendif\n"
"\t\tendif\n"
"\t\t% Leakage Inductance\n"
"\t\tif ((isnan(Lp)) || (Configuration != 1))\n"
"\t\t\tLp\t\t\t= ((4*pi*(MLT*100)*(n_pri^2))/(b*100))*((c*100)+(((ap*100)+(as*"
"100))/3))*1e-9;\n"
"\t\tendif\n"
"\t\tif ((isnan(Ls)) || (Configuration != 1))\n"
"\t\t\tLs\t\t\t= ((4*pi*(MLT*100)*(n_sec^2))/(b*100))*((c*100)+(((ap*100)+(as*"
"100))/3))*1e-9;\t\n"
"\t\tendif\n"
"\t\t% WInding to Winding capacitance\n"
"\t\tif ((isnan(Cps)) || (Configuration != 1))\n"
"\t\t\tCps \t\t= (e0*er_air*IwEr*b*MLT)/((c*er_air)+(Iwl*IwEr)) ;\n"
"\t\tendif\n"
"\tcase 5\n"
"\t\tMLT \t= MLTplanar;\n"
"\t\tWAp \t= PwAp;\n"
"\t\tWAs \t= PwAs;\n"
"\t\t\n"
"\t\tbp \t= Pwtwp;\n"
"\t\tbs \t= Pwtws;\n"
"\t\ttplp \t= floor(Ww/Pwtwp);\n"
"\t\ttpls \t= floor(Ww/Pwtws);\n"
"\t\tap \t= Pwt;\n"
"\t\tas \t= Pwt;\n"
"\t\tp_lay = ceil(n_pri/tplp);\n"
"\t\ts_lay = ceil(n_sec/tpls);\n"
"\t\tc \t\t= Wh-(c_pcb*p_lay)-(c_pcb*s_lay);\n"
"\t\tif (c <= 0)\n"
"\t\t\tc \t= 0.0001;\n"
"\t\t\tplecs('warning', 'Windings will not fit in chosen core, winding insulat"
"ion gap <= 0');\n"
"\t\telse if (c >= cMax)\n"
"\t\t\t\tc = cMax;\n"
"\t\t\t\tplecs('warning', 'Winding insulation gap >= Max set, set to maximum')"
";\n"
"\t\t\tendif\n"
"\t\tendif\n"
"\t\t% Leakage Inductance\n"
"\t\tif ((isnan(Lp)) || (Configuration != 1))\n"
"\t\t\t%printf(\"  MLT = %d\\n\",MLT);\n"
"\t\t\t%printf(\"  bp = %d\\n\",bp);\n"
"\t\t\t%printf(\"  p_lay = %d\\n\",p_lay);\n"
"\t\t\t%printf(\"  s_lay = %d\\n\",s_lay);\n"
"\t\t\t%printf(\"  ap = %d\\n\",ap);\n"
"\t\t\t%printf(\"  as = %d\\n\",as);\n"
"\t\t\t%printf(\"  c_di = %d\\n\",c_di);\n"
"\t\t\t%printf(\"  c_pcb = %d\\n\",c_pcb);\n"
"\t\t\t%printf(\"  c = %d\\n\",c);\n"
"\t\t\tLp\t\t\t= (u0*(MLT/bp)*((n_pri^2)/((p_lay+s_lay-1)^2)))*((((ap*p_lay)+("
"as*s_lay))/3)+((p_lay+s_lay-2)*c_di)+((p_lay+s_lay)*c_pcb)+c);\n"
"\t\tendif\n"
"\t\tif ((isnan(Ls)) || (Configuration != 1))\n"
"\t\t\tLs\t\t\t= (u0*(MLT/bs)*((n_sec^2)/((p_lay+s_lay-1)^2)))*((((ap*p_lay)+("
"as*s_lay))/3)+((p_lay+s_lay-2)*c_di)+((p_lay+s_lay)*c_pcb)+c);\t\n"
"\t\tendif\n"
"\t\t% WInding to Winding capacitance\n"
"\t\tif ((isnan(Cps)) || (Configuration != 1))\n"
"\t\t\tCps \t\t= (e0*er_air*((bp+bs)/2)*MLT)/c ;\n"
"\t\tendif\n"
"\totherwise\n"
"\t\tMLT \t= MLTwire;\n"
"\t\tWAp \t= LwAp;\n"
"\t\tWAs \t= LwAs;\n"
"endswitch\n"
"%printf(\"  Mean Length Turn = %d\\n\",MLT);\n"
"%printf(\"  WAp = %d\\n\",WAp);\n"
"%printf(\"  WAs = %d\\n\",WAs);\n"
"%printf(\"  Winding width = %d\\n\",Ww);\n"
"%printf(\"  Primary winding height = %d\\n\",ap);\n"
"%printf(\"  Secondary winding height = %d\\n\",as);\n"
"%printf(\"  Winding insulation gap = %d\\n\",c);\n"
"Plk \t\t\t= Lp/(n_pri^2);\n"
"%printf(\"  Lp = %d\\n\",Lp);\n"
"%printf(\"  Ls = %d\\n\",Ls);\n"
"%printf(\"  Plk= %d\\n\",Plk);\n"
"%printf(\"  Cps= %d\\n\",Cps);\n"
"%printf(\"  Cp = %d\\n\",Cp );\n"
"%printf(\"  Cs = %d\\n\",Cs);\n"
"\n"
"% Winding resistance\n"
"if (coreTemp == 1) \t\t% Temperature 25C\n"
"\tif ((isnan(Rp)) || (Configuration != 1))\n"
"\t\tRp \t= (1.68e-8 * MLT * n_pri) / WAp;\n"
"\tendif\n"
"\tif ((isnan(Rs)) || (Configuration != 1))\n"
"\t\tRs \t= (1.68e-8 * MLT * n_sec) / WAs;\n"
"\tendif\n"
"else \t\t\t\t\t\t\t% Temperature 100C\n"
"\tif ((isnan(Rp)) || (Configuration != 1))\n"
"\t\tRp \t= ((1.68e-8 * MLT * n_pri) / WAp) * (1+(3.9e-3*75));\n"
"\tendif\n"
"\tif ((isnan(Rs)) || (Configuration != 1))\n"
"\t\tRs \t= ((1.68e-8 * MLT * n_sec) / WAs) * (1+(3.9e-3*75));\n"
"\tendif\n"
"endif\n"
"printf(\"  Rp = %d\\n\",Rp);\n"
"printf(\"  Rs = %d\\n\",Rs);\n"
"\n"
"\n"
"\n"
      MaskDialogCallback "local calculated = Dialog:get('electrical_model_sour"
"ce')\n"
"Dialog:set('Lm', 'Visible', calculated == '2')\n"
"Dialog:set('Lp', 'Visible', calculated == '2')\n"
"Dialog:set('Ls', 'Visible', calculated == '2')\n"
"Dialog:set('Rp', 'Visible', calculated == '2')\n"
"Dialog:set('Rs', 'Visible', calculated == '2')\n"
"Dialog:set('Cps', 'Visible', calculated == '2')\n"
"Dialog:set('Cp', 'Visible', calculated == '2')\n"
"Dialog:set('Cs', 'Visible', calculated == '2')\n"
"local windingType = Dialog:get('winding')\n"
"Dialog:set('Pww', 'Visible', windingType == '5')\n"
"Dialog:set('Pwtwp', 'Visible', windingType == '5')\n"
"Dialog:set('Pwtws', 'Visible', windingType == '5')\n"
"Dialog:set('c_pcb', 'Visible', windingType == '5')\n"
"Dialog:set('c_di', 'Visible', windingType == '5')\n"
"Dialog:set('litzWireAwp', 'Visible', windingType <= '2')\n"
"Dialog:set('litzWireAws', 'Visible', windingType <= '2')\n"
"Dialog:set('LwSp', 'Visible', windingType <= '2')\n"
"Dialog:set('LwSs', 'Visible', windingType <= '2')\n"
"Dialog:set('LwKbw', 'Visible', windingType <= '2')\n"
"Dialog:set('LwKuf', 'Visible', windingType <= '2')\n"
"Dialog:set('IwEr', 'Visible', windingType <= '2')\n"
"Dialog:set('Iwl', 'Visible', windingType <= '2')\n"
