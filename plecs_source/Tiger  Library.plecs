".SUBCKT Z0012 N0EWX N0EW8 N0EVY N0F20 TJ PARAMS: N0EXN=100 N0EYE=100 N0EZP=10"
"0 N0F0I=100 N0F0P=100 N0F14=100 N0F19=100  N0F1A=100\n"
".PARAM N0F29={N0EXN}\n"
".PARAM N0F3H={N0F0I}\n"
".PARAM N0F3M={0}\n"
".PARAM N0F41={1.0}\n"
".PARAM N0F43={1.0}\n"
".PARAM N0F49={0.0}\n"
".PARAM N0F4C={N0F19}\n"
".PARAM N0F4I={0.95}\n"
".PARAM N0F4Y={0.85}\n"
".PARAM N0F52={0.95}\n"
".PARAM N0F5F={N0F1A}\n"
".PARAM N0F62={0.0}\n"
"X04Z8 N0F6H N0F6J N0F6L Z006W PARAMS: N0F6V={N0F4I*N0F29}\n"
"R04ZH N0F6H N0F6L 10G\n"
"R04ZM N0EWX N0F6L 10M\n"
"X04ZP N0F6W N0F6J Z005V PARAMS: N0F81={N0F52*N0F29}\n"
"R04ZS N0F6W N0F6J 10G\n"
"R050X N0EWX N0F6W 80M\n"
"X050Y N0F6H N0EWX N0F8B Z004L PARAMS: N0F8T={N0F4Y*N0F29}\n"
"R050Z N0F6H N0F8B 10G\n"
"R051D N0F8B N0F6J 10M\n"
"G051S N0F8Z N0F6J VALUE={LIMIT(V(N0F9A)*DDT(V(N0F6W,N0F6J))*CDS(V(TJ,0))*N0F9"
"L(V(N0F6W,N0F6J)),0,1E9)}\n"
"V0524 N0F8Z N0F9T DC=0\n"
"R052P N0F9T N0F6J 10G\n"
"R0534 N0EWX N0F9T 2000M\n"
".PARAM N0FA0={0.0001}\n"
".PARAM N0FA4={N0F14}\n"
".PARAM N0FAD={0}\n"
".PARAM N0FBX={0.8}\n"
".PARAM N0FCB={15}\n"
".PARAM N0FCC={25}\n"
".PARAM N0FCL={750}\n"
".PARAM N0FD0={0.0}\n"
"E054S N0FDA 0 VALUE={(((-TANH(N0FBX*V(N0EW8,N0EVY)+N0FAD)+1))/2)*(N0FA0*I(V05"
"AK)/N0F29)}\n"
"R0551 N0FDA 0 1E6\n"
"G0553 N0FDA N0F9A VALUE={IF(V(N0F6W,N0EVY)>0,V(N0FDA,N0F9A)/N0FCC,V(N0FDA,N0F"
"9A)/N0FCB)}\n"
"C0569 N0F9A 0 1E-8\n"
"G056O N0F9A 0 VALUE={IF(V(N0F6W,N0EVY)>N0FCL,1E3*V(N0F9A),0)}\n"
"R056U N0F9A 0 1E9\n"
".FUNC N0F9L(N0FDD)={1-N0FD0*N0FDD}\n"
".FUNC N0FDI(N0FE7)={4E-7*(N0F0P+N0FA4*(N0FE7-25.0))}\n"
".FUNC CDS(N0FE7)={N0F29*N0FDI(N0FE7)}\n"
"V057K N0EW8 N0FFE DC=0\n"
"G057Q N0FFE N0F6H VALUE={IF(I(V057K)>0,V(N0FFE,N0F6H)/N0EYE,V(N0FFE,N0F6H)/N0"
"EZP)}\n"
"X$M014S N0EWX N0F6H N0F6J TJ Z0014 PARAMS: N0FG1={N0F41} N0FHD={N0F43} N0FHO="
"{N0F4C} N0FI0={N0F29} N0FJ7={N0F3H} N0FK1={N0F5F}  N0FL8={N0F62}\n"
"V058Z N0F6J N0EVY DC=0\n"
"X$M059Z N0EWX N0F6H N0FM4 TJ Z0024 PARAMS: N0FG1={N0F41} N0FHD={N0F43} N0FHO="
"{N0F4C} N0FI0={N0F29} N0FMA={N0F49}\n"
"V05AK N0EVY N0FM4 DC=0\n"
"G05CV 0 N0F20 VALUE={LIMIT(I(V058Z)*(V(N0EWX,N0EVY)),-10000K,10000K)}\n"
"R05DT 0 N0F20 1\n"
".ENDS\n"
"\n"
".SUBCKT Z0014 N0EWX N0EW8 N0EVY TJ PARAMS: N0FG1=100 N0FHD=100 N0FHO=100 N0FI"
"0=100 N0FJ7=100 N0FK1=100 N0FL8=100\n"
".FUNC N0FMY(N0FN8) {IF(N0FN8>=0,IF(N0FN8>50,(N0FN8-49)*EXP(50),EXP(N0FN8)),IF"
"(ABS(N0FN8)>50,1/((ABS(N0FN8)-49)*EXP(50))  ,1/EXP(ABS(N0FN8))))}\n"
".FUNC N0FNE(N0FN8) {(1-N0FMY(-2*N0FN8))/(1+N0FMY(-2*N0FN8))}\n"
".FUNC N0FNW(N0FN8) {0.5*(N0FMY(N0FN8)+N0FMY(-N0FN8))}\n"
".FUNC N0FO1(N0FE7,N0FDD,N0FO5)={N0FO5-VGSTH(N0FE7,N0FDD,N0FO5)}\n"
".FUNC VGSTH(N0FE7,N0FDD,N0FO5)={N0FOG+N0FQB*N0FMY(N0FQF*(N0FE7-25))-N0FQJ(N0F"
"E7,N0FDD,N0FO5)+N0FHO }\n"
".FUNC N0FQJ(N0FE7,N0FDD,N0FO5)={N0FQW*N0FDD+N0FQY*N0FNE(N0FR0*N0FDD)}\n"
".FUNC N0FRJ(N0FE7,N0FDD,N0FO5)={((N0FO1(N0FE7,N0FDD,N0FO5)+0.00001+N0FSA*LOG("
"2*N0FNW(N0FO1(N0FE7,N0FDD,N0FO5)/N0FSA)))  )/2}\n"
".FUNC N0FSE(N0FE7,N0FDD,N0FO5)={N0FHD*(N0FTP+N0FUK)*(ABS(N0FRJ(N0FE7,N0FDD,N0"
"FO5))**(N0FUQ+N0FV4*N0FNE(ABS(N0FDD)  **N0FVJ)))}\n"
".FUNC N0FVV(N0FE7,N0FDD,N0FO5)={1/((N0FTP+N0FUK)*ABS(N0FRJ(N0FE7,N0FDD,N0FO5)"
")**N0FVW)}\n"
".FUNC N0FW2(N0FE7)={N0FW4+N0FWT*ABS(N0FE7+50)**2.0}\n"
".FUNC N0FX6(N0FE7,N0FDD,N0FO5)={N0FSE(N0FE7,N0FDD,N0FO5)*N0FNE(N0FDD/(N0FSE(N"
"0FE7,N0FDD,N0FO5)*N0FVV  (N0FE7,N0FDD,N0FO5)))}\n"
".FUNC N0FXE(N0FE7,N0FDD,N0FO5)={N0FX6(N0FE7,N0FDD,N0FO5)+N0FMY(0.25*(N0FDD-VB"
"R))}\n"
".FUNC N0FYL(N0FE7,N0FDD)={N0FDD/(N0FW2(N0FE7))}\n"
".PARAM N0FQW={0.0020}  N0FQY={0.75}  N0FR0={0.01}  N0FOG={1.02559}  N0FQB={4."
"9739}  N0FQF={-0.00115}  N0FTP={0.21}  N0FUK={N0FK1}  N0FVW={1.6532}  N0FVJ={"
"0.2}  N0FV4={1.0}  N0FUQ={1.5}  N0FWT={0.0000056}  N0FW4={0.052}  VBR={N0FJ7}"
"  N0FSA={2}  N0FYR={0.0}\n"
"G05EJ N0FYT N0EVY VALUE={N0FI0*N0FG1*N0FXE(V(TJ,0),V(N0FYT,N0EVY),V(N0EW8,N0E"
"VY))}\n"
"G05FY N0EWX N0FYT VALUE={N0FI0*N0FG1*N0FYL(V(TJ,0),V(N0EWX,N0FYT))}\n"
"R05G0 N0FYT 0 1E9\n"
".ENDS\n"
"\n"
".SUBCKT Z0024 N0EWX N0EW8 N0EVY TJ PARAMS: N0FG1=100 N0FHD=100 N0FHO=100 N0FI"
"0=100 N0FMA=100\n"
".FUNC N0FMY(N0FN8) {IF(N0FN8>=0,IF(N0FN8>50,(N0FN8-49)*EXP(50),EXP(N0FN8)),IF"
"(ABS(N0FN8)>50,1/((ABS(N0FN8)-49)*EXP(50))  ,1/EXP(ABS(N0FN8))))}\n"
".FUNC N0FNE(N0FN8) {(1-N0FMY(-2*N0FN8))/(1+N0FMY(-2*N0FN8))}\n"
".FUNC N0FYX(N0FDD,N0FE7,N0FO5)={(N0FZ6+N0FZM*(N0FE7-25))*ABS(-N0FDD-N0FZT(N0F"
"E7,N0FO5))**N0G0X}\n"
".FUNC N0FZT(N0FE7,N0FO5)={N0G1M-(N0G27-N0G2E*(N0FE7-25))*(1+N0FNE(N0G2L*N0FO5"
"+N0G2M))+N0FMA}\n"
".PARAM N0FZ6={0.8}  N0G0X={2.0}  N0G1M={2.7}  N0FZM={0.002}  N0G27={0.4}  N0G"
"2E={0.0004}  N0G2L={1.0}  N0G2M={1.0}  N0FTP={1.15}  N0FVW={1.0}\n"
"G05GE N0EWX N0EVY VALUE={N0FI0*IF(V(N0EW8,N0EVY)>25,1E-12,IF(V(N0EWX,N0EVY)>-"
"N0FZT(V(TJ,0),V(N0EW8,N0EVY)),1E-12,-N0FYX  (V(N0EWX,N0EVY),V(TJ,0),V(N0EW8,N"
"0EVY))))}\n"
".ENDS\n"
"\n"
".SUBCKT Z004L N0EW8 N0EWX N0EVY PARAMS: N0F8T=100\n"
".FUNC N0FMY(N0FN8) {IF(N0FN8>=0,IF(N0FN8>50,(N0FN8-49)*EXP(50),EXP(N0FN8)),IF"
"(ABS(N0FN8)>50,1/((ABS(N0FN8)-49)*EXP(50))  ,1/EXP(ABS(N0FN8))))}\n"
".FUNC N0FNE(N0FN8) {(1-N0FMY(-2*N0FN8))/(1+N0FMY(-2*N0FN8))}\n"
".PARAM N0G2N={0.0528}  N0G2V={5.5E-09}  N0G32={1.12E-13}  N0G49={3.1314}  N0G"
"4H={2.4E-10}  N0G4Q={0.31818}  N0G4X={0.5}  N0G6E={9}  N0G6S={0.1}  N0G6Z={2."
"0E-9}\n"
".FUNC N0G7G(N0G7U)={N0G2V }\n"
".FUNC N0G8I(N0G7U)={-N0G32*N0G7U }\n"
".FUNC N0G8X(N0G7U)={N0G4H*(N0FNE(N0G4Q*(N0G7U-N0G49))+1.0)}\n"
".FUNC CGS(N0G7U)={N0G7G(N0G7U)+N0G8I(N0G7U)+N0G8X(N0G7U)}\n"
"G05GF N0EW8 N0EVY VALUE={N0G2N*N0F8T*DDT(V(N0EW8,N0EVY))*(CGS(V(N0EWX,N0EVY))"
"+N0G4X*N0G6Z*(N0FNE(N0G6S*(V(N0EW8,N0EVY)  -N0G6E))+1.0))}\n"
".ENDS Z004L\n"
"\n"
".SUBCKT Z005V N0EWX N0EVY PARAMS: N0F81=100\n"
".FUNC N0FMY(N0FN8) {IF(N0FN8>=0,IF(N0FN8>50,(N0FN8-49)*EXP(50),EXP(N0FN8)),IF"
"(ABS(N0FN8)>50,1/((ABS(N0FN8)-49)*EXP(50))  ,1/EXP(ABS(N0FN8))))}\n"
".FUNC N0FNE(N0FN8) {(1-N0FMY(-2*N0FN8))/(1+N0FMY(-2*N0FN8))}\n"
".PARAM N0G9J={11.5}\n"
".PARAM N0G9O={4.9895E-12}\n"
".PARAM N0G9S={2.2862E-12}\n"
".PARAM N0G9V={-0.0038244}\n"
".PARAM N0GAM={1.2317E-11}\n"
".PARAM N0GAQ={-0.14349}\n"
".PARAM N0GAR={1.0575}\n"
".PARAM N0GAZ={4.3346E-12}\n"
".PARAM N0GBI={-0.030623}\n"
".PARAM N0GCQ={18.7637}\n"
".PARAM N0GCW={-4.0274E-12}\n"
".PARAM N0GD0={-0.41425}\n"
".FUNC N0GDY(N0G7U)={N0G9O }\n"
".FUNC N0GFU(N0G7U)={N0G9S*N0FMY(N0G9V*N0G7U)}\n"
".FUNC N0GG4(N0G7U)={N0GAM*N0FMY(N0GAQ*N0G7U)}\n"
".FUNC N0GGB(N0G7U)={N0GAZ*N0FMY(N0GBI*(N0G7U-N0GAR))}\n"
".FUNC N0GGN(N0G7U)={N0GCW*0.5*(-N0FNE(N0GD0*(N0G7U-N0GCQ))+1.0)}\n"
".FUNC CDS(N0G7U)={N0GDY(N0G7U)+N0GFU(N0G7U)+N0GG4(N0G7U)+N0GGB(N0G7U)+N0GGN(N"
"0G7U)}\n"
"G051S N0EWX N0EVY VALUE={N0F81*N0G9J*DDT(V(N0EWX,N0EVY))*IF(V(N0EWX,N0EVY)>0,"
"CDS(V(N0EWX,N0EVY)),CDS(0.0))}\n"
".ENDS Z005V\n"
"\n"
".SUBCKT Z006W N0EW8 N0EVY N0EWX PARAMS: N0F6V=100\n"
".FUNC N0FMY(N0FN8) {IF(N0FN8>=0,IF(N0FN8>50,(N0FN8-49)*EXP(50),EXP(N0FN8)),IF"
"(ABS(N0FN8)>50,1/((ABS(N0FN8)-49)*EXP(50))  ,1/EXP(ABS(N0FN8))))}\n"
".FUNC N0FNE(N0FN8) {(1-N0FMY(-2*N0FN8))/(1+N0FMY(-2*N0FN8))}\n"
".PARAM N0GGP={1.0}\n"
".PARAM N0GHI={10.1246E-13}\n"
".PARAM N0GIJ={4.312E-11}\n"
".PARAM N0GIQ={-0.35325}\n"
".PARAM N0GIR={1.4227E-12}\n"
".PARAM N0GJ3={-0.0046989}\n"
".PARAM N0GJH={2.8161E-12}\n"
".PARAM N0GJL={-0.036418}\n"
".PARAM N0GK6={15.7629}\n"
".PARAM N0GK8={9.291E-12}\n"
".PARAM N0GKO={0.45656}\n"
".PARAM N0GLZ={11.9961}\n"
".PARAM N0GMK={1.2487E-11}\n"
".PARAM N0GNF={0.14317}\n"
".FUNC N0GOB(N0G7U)={N0GHI }\n"
".FUNC N0GOL(N0G7U)={N0GIJ*N0FMY(N0GIQ*N0G7U)}\n"
".FUNC N0GOZ(N0G7U)={N0GIR*N0FMY(N0GJ3*N0G7U)}\n"
".FUNC N0GP1(N0G7U)={N0GJH*N0FMY(N0GJL*N0G7U)}\n"
".FUNC N0GPQ(N0G7U)={N0GK8*0.5*(-N0FNE(N0GKO*(N0G7U-N0GK6))+1.0)}\n"
".FUNC N0GQ5(N0G7U)={N0GMK*0.5*(-N0FNE(N0GNF*(N0G7U-N0GLZ))+1.0)}\n"
".FUNC CGD(N0G7U)={N0GOB(N0G7U)+N0GOL(N0G7U)+N0GOZ(N0G7U)+N0GP1(N0G7U)+N0GPQ(N"
"0G7U)+N0GQ5(N0G7U)}\n"
"G05HK N0EW8 N0EWX VALUE={N0F6V*N0GGP*DDT(V(N0EW8,N0EWX))*IF(V(N0EWX,N0EVY)>0,"
"CGD(V(N0EWX,N0EVY)),CGD(0.0))}\n"
".ENDS Z006W\n"
"\n"
".SUBCKT Z0081 TJ TCASE N0GQG\n"
