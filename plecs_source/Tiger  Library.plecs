"\t\t\t%printf(\"HF Transformer core material = N87, 100C\\n  Intial Permativi"
"ty=%d,\\n  Saturated Permativity=%d,\\n  Saturation Flux Density=%d,\\n  Rema"
"nance Flux Density=%d,\\n  Saturation Field Strength=%d\\n  Coercive Field St"
"rength=%d,\\n\", u_i, u_s, B_s, B_r, H_s, H_c);\n"
"\t\tendif\n"
"\tcase 4 \t\t\t\t\t\t\t% Metglas 2605SA1 (https://metglas.com/wp-content/uplo"
