    Component {
      Type          ConfigurableSubsystem
      Name          "\nHF Transformer"
      Show          on
      Position      [205, 115]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-15, -15; 15, 15]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "Configurable Transformer"
      MaskDescription "Choose between:\n"
"1. Ideal electrical transformer model\n"
"2. Magnetic transformer model with a saturable core\n"
"3. Hysterical Magnetic transformer model with a hysterical core"
      MaskDisplay   "local config = Dialog:get('Configuration')\n"
"\n"
"Icon:color(128, 128, 128)\n"
"Icon:line({10, 10, 8, 6, 5, 5, 6, 8, 10, 8, 6, 5, 5, 6, 8, 10, 8, 6, 5, 5, 6,"
" 8, 10, 8, 6, 5, 5, 6, 8, 10, 10} ,    {-15, -14, -14, -13, -11, -10,  -8,  -"
"7,  -7,  -7,  -6,  -4,  -3,  -1,   0,   0,   0,   1,   3,   4,   6,   7,   7,"
"   7,   8,  10,  11,  13,  14,  14,  15})\n"
"Icon:line({-10, -10, -8, -6, -5, -5, -6, -8, -10, -8, -6, -5, -5, -6, -8, -10"
", -8, -6, -5, -5, -6, -8, -10, -8, -6, -5, -5, -6, -8, -10, -10} ,    {-15, -"
"14, -14, -13, -11, -10,  -8,  -7,  -7,  -7,  -6,  -4,  -3,  -1,   0,   0,   0"
",   1,   3,   4,   6,   7,   7,   7,   8,  10,  11,  13,  14,  14,  15})\n"
"\n"
"Icon:line({1,1,1},{-15,0,15})\n"
"Icon:line({-1,-1,-1},{-15,0,15})"
      MaskDisplayLang "2"
      MaskIconFrame off
      MaskIconOpaque on
      MaskIconRotates on
      MaskInit      "% Constanats\n"
"pi \t\t\t= pi(); \t\t\t\t% pi\n"
"u0 \t\t\t= pi*4e-7;\t\t\t% H/m - Permability of a vacume\n"
"e0 \t\t\t= 8.8541878128e-12;% permativity of free space\n"
"er_air \t\t= 1.00058986; \t\t% relative permativity of air\n"
"\n"
"switch (material) \t\t\t\t% Set core material parameters\n"
"\tcase 1 \t\t\t\t\t\t\t% TDK/EPCOS N97 (https://www.tdk-electronics.tdk.com/d"
"ownload/528886/cf0d9784d3d2438b52ade72fbb86ecf6/pdf-n97.pdf)\n"
"\t\tif (coreTemp == 1) \t\t% Temperature 25C\n"
"\t\t\tu_i = 2300;\n"
"\t\t\tu_s = 1;\n"
"\t\t\tB_s = 0.510;\n"
"\t\t\tB_r = 0.24;\n"
"\t\t\tH_s = 1200;\n"
"\t\t\tH_c = 21;\n"
"\t\t\tif ((Configuration == 3) && (H_c/H_s < 0.05))\n"
"\t\t\t\tH_s = H_c/0.05;\n"
"\t\t\t\tplecs('warning', 'H_s set to H_c/0.05 to meet condition: H_c/H_sat >="
" 0.05');\n"
"\t\t\tendif\n"
"\t\t\t%printf(\"HF Transformer core material = N97, 25C\\n  Intial Permativit"
"y=%d,\\n  Saturated Permativity=%d,\\n  Saturation Flux Density=%d,\\n  Reman"
"ance Flux Density=%d,\\n  Saturation Field Strength=%d\\n  Coercive Field Str"
"ength=%d,\\n\", u_i, u_s, B_s, B_r, H_s, H_c);\n"
"\t\telse \t\t\t\t\t\t\t% Temperature 100C\n"
"\t\t\tu_i = 4000;\n"
"\t\t\tu_s = 1;\n"
"\t\t\tB_s = 0.410;\n"
"\t\t\tB_r = 0.125;\n"
"\t\t\tH_s = 1200;\n"
"\t\t\tH_c = 12;\n"
"\t\t\tif ((Configuration == 3) && (H_c/H_s < 0.05))\n"
"\t\t\t\tH_s = H_c/0.05;\n"
"\t\t\t\tplecs('warning', 'H_s set to H_c/0.05 to meet condition: H_c/H_sat >="
" 0.05');\n"
"\t\t\tendif\n"
"\t\t\t%printf(\"HF Transformer core material = N97, 100C\\n  Intial Permativi"
"ty=%d,\\n  Saturated Permativity=%d,\\n  Saturation Flux Density=%d,\\n  Rema"
"nance Flux Density=%d,\\n  Saturation Field Strength=%d\\n  Coercive Field St"
"rength=%d,\\n\", u_i, u_s, B_s, B_r, H_s, H_c);\n"
"\t\tendif\n"
"\tcase 2 \t\t\t\t\t\t\t% TDK/EPCOS N87 (https://www.tdk-electronics.tdk.com/d"
"ownload/528882/71e02c7b9384de1331b3f625ce4b2123/pdf-n87.pdf)\n"
"\t\tif (coreTemp == 1) \t\t% Temperature 25C\n"
"\t\t\tu_i = 2200;\n"
"\t\t\tu_s = 1;\n"
"\t\t\tB_s = 0.490;\n"
"\t\t\tB_r = 0.15;\n"
"\t\t\tH_s = 1200;\n"
"\t\t\tH_c = 21;\n"
"\t\t\tif ((Configuration == 3) && (H_c/H_s < 0.05))\n"
"\t\t\t\tH_s = H_c/0.05;\n"
"\t\t\t\tplecs('warning', 'H_s set to H_c/0.05 to meet condition: H_c/H_sat >="
" 0.05');\n"
"\t\t\tendif\n"
"\t\t\t%printf(\"HF Transformer core material = N87, 25C\\n  Intial Permativit"
"y=%d,\\n  Saturated Permativity=%d,\\n  Saturation Flux Density=%d,\\n  Reman"
"ance Flux Density=%d,\\n  Saturation Field Strength=%d\\n  Coercive Field Str"
"ength=%d,\\n\", u_i, u_s, B_s, B_r, H_s, H_c);\n"
"\t\telse \t\t\t\t\t\t\t% Temperature 100C\n"
