    Component {
      Type          ConfigurableSubsystem
      Name          "mk4a-4026980"
      Show          on
      Position      [1070, 870]
      Direction     up
      Flipped       off
      LabelPosition north
      Frame         [-40, -10; 40, 10]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "4026980 Inductor"
      MaskDescription "4026980 Inductor for Mk4q power output filter\n"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      MaskInit      "switch coreMaterial\n"
"\tcase 1 %'3C90' % 3C90\n"
"\t\tswitch CoreTemp\n"
"\t\t\tcase 1 % '25C' % 25C\n"
"\t\t\t\tHc \t= 14;\n"
"\t\t\t\tBr \t= 0.16;\n"
"\t\t\t\tHsat \t= 250;\n"
"\t\t\t\tBsat \t= 0.45;\n"
"\t\t\t\tUsat \t= 1;\n"
"\t\t\t\tUr \t= 4800;\n"
"\t\t\t\tprintf(\"4026980 Core = 3C90, 25C Hc=%d,Br=%d,Hsat=%d,Bsat=%d,Usat=%d"
",Ur=%d\\n\", Hc, Br, Hsat, Bsat, Usat, Ur);\n"
"\t\t\totherwise % 100C\n"
"\t\t\t\tHc \t= 13;\n"
"\t\t\t\tBr \t= 0.13;\n"
"\t\t\t\tHsat \t= 250;\n"
"\t\t\t\tBsat \t= 0.35;\n"
"\t\t\t\tUsat \t= 1;\n"
"\t\t\t\tUr \t= 5500;\n"
"\t\t\t\tprintf(\"4026980 Core = 3C90, 100C Hc=%d,Br=%d,Hsat=%d,Bsat=%d,Usat=%"
"d,Ur=%d\\n\", Hc, Br, Hsat, Bsat, Usat, Ur);\n"
"\t\tendswitch\n"
"\tcase 2 % 'PL-7' \n"
"\t\tswitch CoreTemp\n"
"\t\t\tcase 1 % '25C'\n"
"\t\t\t\tHc \t= 12;\n"
"\t\t\t\tBr \t= 0.15;\n"
"\t\t\t\tHsat \t= 240;\n"
"\t\t\t\tBsat \t= 0.45;\n"
"\t\t\t\tUsat \t= 2;\n"
"\t\t\t\tUr \t= 2400;\n"
"\t\t\t\tprintf(\"4026980 Core = PL-7, 25C Hc=%d,Br=%d,Hsat=%d,Bsat=%d,Usat=%d"
",Ur=%d\\n\", Hc, Br, Hsat, Bsat, Usat, Ur);\n"
"\t\t\totherwise\n"
"\t\t\t\tHc \t= 12;\n"
"\t\t\t\tBr \t= 0.15;\n"
"\t\t\t\tHsat \t= 240;\n"
"\t\t\t\tBsat \t= 0.375;\n"
"\t\t\t\tUsat \t= 1;\n"
"\t\t\t\tUr \t= 4000;\n"
"\t\t\t\tprintf(\"4026980 Core = PL-7, 100C Hc=%d,Br=%d,Hsat=%d,Bsat=%d,Usat=%"
"d,Ur=%d\\n\", Hc, Br, Hsat, Bsat, Usat, Ur);\n"
"\t\tendswitch\n"
"\totherwise \n"
"\t\tswitch CoreTemp\n"
"\t\t\tcase 1 % '25C'\n"
"\t\t\t\tHc \t= 21;\n"
"\t\t\t\tBr \t= 0.20;\n"
"\t\t\t\tHsat \t= 420;\n"
"\t\t\t\tBsat \t= 0.47;\n"
"\t\t\t\tUsat \t= 2;\n"
"\t\t\t\tUr \t= 2200;\n"
"\t\t\t\tprintf(\"4026980 Core = N87, 25C Hc=%d,Br=%d,Hsat=%d,Bsat=%d,Usat=%d,"
"Ur=%d\\n\", Hc, Br, Hsat, Bsat, Usat, Ur);\n"
"\t\t\totherwise\n"
"\t\t\t\tHc \t= 13;\n"
"\t\t\t\tBr \t= 0.10;\n"
"\t\t\t\tHsat \t= 260;\n"
"\t\t\t\tBsat \t= 0.37;\n"
"\t\t\t\tUsat \t= 1.2;\n"
"\t\t\t\tUr \t= 3500;\n"
"\t\t\t\tprintf(\"4026980 Core = N87, 25C Hc=%d,Br=%d,Hsat=%d,Bsat=%d,Usat=%d,"
"Ur=%d\\n\", Hc, Br, Hsat, Bsat, Usat, Ur);\n"
"\t\tendswitch\n"
"endswitch\n"
"\t\t\t\n"
"\t\t\t\n"
