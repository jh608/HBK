                    }
                  }
                  Component {
                    Type          CScript
                    Name          "C-Script"
                    Show          on
                    Position      [160, 60]
                    Direction     up
                    Flipped       off
                    LabelPosition south
                    Parameter {
                      Variable      "DialogGeometry"
