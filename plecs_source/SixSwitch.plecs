                      Show          off
                    }
                  }
                  Component {
                    Type          Output
                    Name          "s"
                    Show          on
                    Position      [275, 60]
                    Direction     right
                    Flipped       off
                    LabelPosition south
                    Parameter {
                      Variable      "Index"
