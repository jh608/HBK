Plecs {
  Name          "SixSwitch"
  Version       "4.9"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "1.0"
  Timeout       ""
  Solver        "auto"
  MaxStep       "1e-3"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "1"
  NegativeSwitchLossMsg "1"
  DivisionByZeroMsg "2"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "Vf = 1;\n% dt = 200e-9;\nCeqv = 3.11e-9;\nVin = 700;"
"\nVout = 300;\nPout = 16000;\nR_Co = 1e-2;\nL = 400e-6;\nCout = 75e-6;\nCcd ="
" 12000e-6;\nn_pri = 14;\nn_sec = 5;\n\n%MOSFET Parameters\nRgOn = 1;\nRgOff ="
" 1;\nnum_par_switch = 1;\nVf = 1.0;\n\n% Modulator\nSwitchingFrequency = 100e"
"3; % switching frequency\nAvergingTime = 1/(SwitchingFrequency/50);\nDeadTime"
" = 100e-9;\nTs = 1/SwitchingFrequency;         \t\t% sample time (s)\n\n%Heat"
" Sink parameters\nTamb = 50;\nT_init = 75;\nCuCoinCth = 0.385;\nRth_ch = 0.03"
"3; \nRth_cctb = 0.013;\nRth_sp = 0.013;\n\n% Payton T250-4-16 transformer, ma"
"terial: TP4A modified to n = 2.6666\n% n_pri = 4;      % number of turns on t"
"he primary side\n% n_sec = 16;     % number of turns on the secondary side\nA"
"e = 229e-6;    % cross-sectional area (m^2)\nLe = 60e-3;     % length of flux"
" path (m)\n\nB_sat = 510e-3; % saturation magnetic flux denisty (T)\nH_sat = "
"1194;   % saturation magnetic field strength (A/m)\n\nu0 = 4*pi*1e-7; % perme"
"ability of free space (m*kg*s^-2*A^-2)\nur_init = 2400; % unsaturated relativ"
"e permeability\nur_sat = 4;     % saturated relative permeability - tangentia"
"l slope of the BH curve at Hsat\n\n% Six Switch\ngridVoltageLLrms = 380;\ngri"
"dFrequency = 50;\nVgrid_pk = (gridVoltageLLrms/sqrt(3))*sqrt(2);   % grid vol"
"tage (V, line-to-neutral)\nfgrid = 50;\t\t\t% grid frequency (Hz)\noffset = p"
"i/2;\t\t% grid phase offset (rad)\nLline = 0.0005;\t\t\t% line inductance (H)"
"\nVdc_ref = Vin;\t\t% DC-bus reference voltage (V)\nfs = 100e3;\t\t\t% switch"
"ing frequency (Hz)\ngrid_sr = 32e3;\t\t\t% grid ADC sample rate (Hz)\ncap = 7"
"5e-6;\t\t\t% DC-bus capacitance (F)\nV_init = Vdc_ref;\t\t% initial DC-bus vo"
"ltage (V)\nLf = 35e-6;\nCf = 2.2e-6;\n\n% Class D Parameters\nSigType = 1; % "
"Sine\n%SigType = 2; % Shock\n%SigType = 3; % DC\n%SigType = 4; % External\nSi"
"neFreq = 20;\nSineIOut = 160*sqrt(2);\nSineVOut = 100*sqrt(2);\nShockPulse = "
"11e-3;\nShockI = 640;\nShockV = 300;\nDCI = 180;\nDCV = 100;"
