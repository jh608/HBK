                      Value         ""
                      Show          off
                    }
                    Parameter {
                      Variable      "StoreCustomStateFcn"
                      Value         "WriteCustomStateDouble(NextSampleHit);\n"
"WriteCustomStateDouble(time_stamp);"
                      Show          off
                    }
                    Parameter {
