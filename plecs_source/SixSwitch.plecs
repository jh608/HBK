              SrcTerminal   1
              DstComponent  "Configurable\nSubsystem"
              DstTerminal   1
            }
          }
        }
        Component {
          Type          Subsystem
          Name          "3-Phase Index-Based\nModulation"
          Show          on
          Position      [240, 90]
          Direction     up
          Flipped       off
          LabelPosition south
          Frame         [-20, -20; 20, 20]
          SampleTime    "-1"
          CodeGenDiscretizationMethod "2"
          CodeGenTarget "Generic"
          MaskType      "3-Phase Index-Based Modulation"
          MaskDescription "This block generates the modulation index for a thr"
"ee-phase reference voltage defined by the input Vabc*. This block may be used"
" in series with a PWM generation block for the control of three-phase inverte"
"rs without neutral point connection."
          MaskHelp      "qthelp:///indexbasedmodu.html"
          MaskDisplayLang "2"
          MaskIconFrame on
          MaskIconOpaque off
          MaskIconRotates on
          Parameter {
            Variable      "config"
            Prompt        "Modulation strategy"
            Type          FixedText
            PossibleValues {"Sinusoidal PWM", "Space Vector PWM (Symmetrical)", ""
"Space Vector PWM (DPWM0)", "Space Vector PWM (DPWM1)", "Space Vector PWM (DPW"
"M2)", "Space Vector PWM (DPWM3)", "Space Vector PWM (DPWMMIN)", "Space Vector"
" PWM (DPWMMAX)"}
            Value         "config"
            Show          off
            Tunable       off
            TabName       ""
          }
          Terminal {
            Type          Output
            Position      [24, 0]
            Direction     right
          }
          Terminal {
