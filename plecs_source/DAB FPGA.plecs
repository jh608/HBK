        Value         "#define m InputSignal(0,0)\n"
"#define enable InputSignal(0,1)"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "if(enable ==1)\n"
"{\n"
"\tif(m<=1)\n"
"\t{\n"
"\t\tif(0.5*(1-m) > 0.045)\n"
"\t\t{\n"
"\t\t\tOutputSignal(0,0) = 0.5*(1-m);\n"
"\t\t}\n"
"\t\telse \n"
"\t\t{\n"
"\t\t\tOutputSignal(0,0) = 0.045;\n"
"\t\t}\n"
"\t\tOutputSignal(0,1) = 0.045;\n"
"\t}\n"
"\telse\n"
"\t{\n"
"\t\tOutputSignal(0,0) = 0.045;\n"
"\t\tif(0.5*(1-(1/m)) > 0.045)\n"
"\t\t{\n"
"\t\t\tOutputSignal(0,1) = 0.5*(1-(1/m));\n"
"\t\t}\n"
"\t\telse \n"
"\t\t{\n"
"\t\t\tOutputSignal(0,1) = 0.045;\n"
"\t\t}\n"
"\t}\n"
"}\n"
"else\n"
"{\n"
"\tOutputSignal(0,0) = 0;\n"
"\tOutputSignal(0,1) = 0;\n"
"}\n"
        Show          off
      }
