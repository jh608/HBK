Plecs {
  Name          "DAB FPGA"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "timeSpan"
  Timeout       ""
  Solver        "auto"
  MaxStep       "1e-3"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "2"
  NegativeSwitchLossMsg "2"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "% pi = 3.14159265359;\n% timeSpan\ntimeSpan = 0.004;"
"\n% timeSpan = 1.0;\n% Simulation mode setting\nPLECS   = 1;\nSPICE   = 2;\ns"
"imMode = PLECS;\n\n% Script options\nForce = 1;\nDp=1.0;\nDs=0.95;\n\n% Input"
" voltage\nVin = 700;\n% Vout target\nVout = 250;\nCapVout = Vout;\n% CapVout "
"= 0.1;\n\n% Cin\nCin = 30e-6; \nR_Cin = 1e-2;\n\n% Cout\nCout = 1e-3;\nR_Cout"
" = 0.003;\n\n% DC bus cap\nCdc = 18000e-6;\nR_Cdc = 0.016;\n\n% Load Power \n"
"Pout = 16000;\n\n% Modulator\nSwitchingFrequency = 150e3; % switching frequen"
"cy\nAvergingTime = 1/(SwitchingFrequency/50);\nDeadTime = 100e-9;\nTs = 1/Swi"
"tchingFrequency;         \t\t% sample time (s)\n%DeadTime = 3.3333e-6/2;\nRgo"
"n = 2;\nRgoff = 2;\nCsnub = 150e-12;\nRsnub = 4.7;\n\n% Transformer\nLlk = 13"
"e-6;\nLm = 1.3e-3;\nn_pri = 11;\nn_sec = 4;\nprintf('Llk : %e H\\n', Llk);\nL"
"lkp = Llk/2.0;\nprintf('Llkp : %e H\\n', Llkp);\nLlks = (Llk/2)/((n_pri/n_sec"
")^2);\nprintf('Llks : %e H\\n', Llks);\nresonantFrequency  = SwitchingFrequen"
"cy / 1.2;\nCr = 1/(((2*pi*resonantFrequency )^2)*Llk);\nprintf('Cr : %e F\\n'"
", Cr);\nCrp = 1/(((2*pi*resonantFrequency)^2)*Llkp);\nprintf('Crp : %e F\\n',"
" Crp);\nCrs = 1/(((2*pi*resonantFrequency)^2)*Llks);\nprintf('Crs : %e F\\n',"
" Crs);\n\n% Digital PI controller\n% Kp = 0.125; \t\t% proportional gain\n% K"
"i = 0.002;       % integral gain\n% Kd = 0;           % derivative gain\n\n%H"
"eat Sink parameters\nTamb = 50;\nT_init = 50;\nCth_package = 0.0081 * 900; % "
"Cth = m x c = 8.1g x 900J/(kg.K)\n% Cth_package = 0.0081 * 0.09; % Cth = m x "
"c = 8.1g x 900J/(kg.K) / 10000 (for sim speed)\nRth_jc_max = 0.31 % from data"
" sheet\n% Rth_tim = 0.239; \nRth_tim = 0.0; \nCth_hs = 0.172505 * 900; % Cth "
"= m x c = 172.505g x 900J/(kg.K)\n% Cth_hs = 0.172505 * 0.009; % Cth = m x c "
"= 172.505g x 900J/(kg.K) / 100000 (for sim speed)\n% Cth_hs = 0; % Cth = m x "
"c = 172.505g x 900J/(kg.K) / 100000 (for sim speed)\nRth_hs_amb = 0.50;\n\n% "
"TPS Coeficents\n% 700/200\n% dp \n%tpsDpSlope = -7.5594;\n%tpsDpIntercept = 1"
".2334;\n%tpsDpMax = 1.0;\n%tpsDpMin = 0.4;\n% ds\n%tpsDsSlope = -9.169;\n%tps"
"DsIntercept = 1.4243;\n%tpsDsMax = 0.96;\n%tpsDsMin = 0.75;\n\n% 700/250\n% d"
"p \n%tpsDpSlope = -0.6477;\n%tpsDpIntercept = 1.0195;\n%tpsDpMax = 1.0;\n%tps"
"DpMin = 0.9;\n% ds\n%tpsDsSlope = -2.1227;\n%tpsDsIntercept = 0.9603;\n%tpsDs"
"Max = 0.95;\n%tpsDsMin = 0.70;\n\n% 700/250\n% dp \ntpsDpSlope = 0.0;\ntpsDpI"
"ntercept = 1.0;\ntpsDpMax = 1.0;\ntpsDpMin = 1.0;\n% ds\ntpsDsSlope = 0.0;\nt"
"psDsIntercept = 0.95;\ntpsDsMax = 0.95;\ntpsDsMin = 0.95;\n\n% 700/300\n% dp "
"\n%tpsDpSlope = 13.627;\n%tpsDpIntercept = 0.3557;\n%tpsDpMax = 1.0;\n%tpsDpM"
"in = 0.4;\n% ds\n%tpsDsSlope = 11.387;\n%tpsDsIntercept = 0.2557;\n%tpsDsMax "
"= 0.75;\n%tpsDsMin = 0.25;\n\n% 700/350\n% dp \n%tpsDpSlope = 12.702;\n%tpsDp"
"Intercept = 0.1882;\n%tpsDpMax = 1.0;\n%tpsDpMin = 0.3;\n% ds\n%tpsDsSlope = "
"9.218;\n%tpsDsIntercept = 0.1107;\n%tpsDsMax = 0.65;\n%tpsDsMin = 0.20;\n\n% "
"700/400\n% dp \n%tpsDpSlope = 8.6043;\n%tpsDpIntercept = 0.2531;\n%tpsDpMax ="
" 1.0;\n%tpsDpMin = 0.1;\n% ds\n%tpsDsSlope = 4.2421;\n%tpsDsIntercept = 0.153"
"8;\n%tpsDsMax = 0.55;\n%tpsDsMin = 0.1;\n\n% 800/200\n% dp \n%tpsDpSlope = 5."
"803801;\n%psDpIntercept = 0.341217;\n%tpsDpMax = 0.8;\n%tpsDpMin = 0.25;\n% d"
"s\n%tpsDsSlope = 6.466859;\n%tpsDsIntercept = 0.496296;\n%tpsDsMax = 0.95;\n%"
"tpsDsMin = 0.35;\n\n% 800/250\n% dp \n%tpsDpSlope = 2.019907;\n%tpsDpIntercep"
"t = 0.803222;\n%tpsDpMax = 0.9;\n%tpsDpMin = 0.75;\n% ds\n%tpsDsSlope = 0.600"
"61;\n%tpsDsIntercept = 0.907373;\n%tpsDsMax = 1.0;\n%tpsDsMin = 0.85;\n\n% 80"
"0/300\n% dp \n%tpsDpSlope = 8.655521;\n%tpsDpIntercept = 0.64135;\n%tpsDpMax "
"= 1.0;\n%tpsDpMin = 0.55;\n% ds\n%tpsDsSlope = 7.849687;\n%tpsDsIntercept = 0"
".551767;\n%tpsDsMax = 0.9;\n%tpsDsMin = 0.45;\n\n% 800/350\n% dp \n%tpsDpSlop"
"e = 20.13068;\n%tpsDpIntercept = 0.103713;\n%tpsDpMax = 1.0;\n%tpsDpMin = 0.3"
";\n% ds\n%tpsDsSlope = 15.72766;\n%tpsDsIntercept = 0.047805;\n%tpsDsMax = 0."
"75;\n%tpsDsMin = 0.2;\n\n% 800/400\n% dp \n%tpsDpSlope = 11.68761;\n%tpsDpInt"
"ercept = 0.268043;\n%tpsDpMax = 0.975;\n%tpsDpMin = 0.3;\n% ds\n%tpsDsSlope ="
" 8.244124;\n%tpsDsIntercept = 0.152675;\n%tpsDsMax = 0.625;\n%tpsDsMin = 0.2;"
"\n"
