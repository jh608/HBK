  Script {
    Name          "TPS Sweep"
    Script        "% Clear all previous traces in scope 'Scope' in the current"
" model\n% plecs('clc');\nsetupName  = 'SrPri250pSec1890p150k150pSnuberResults"
"_Sweep'\nfilename = ['Results/TPS_' setupName '_' datestr(date())];\ncsvfilen"
"ame = [filename '.csv'];\nsignalList = {\"Vout\";\"Iout\";\"Pout\";\"Total Lo"
"ss\";\"Efficiancy\";\"Primary Conduction Loss\";\"Primary Switching Loss\";\""
"Primary Total Loss\";\"Primary Max Loss 1 FET\";\"Secondary Conduction Loss\""
";\"Secondary Switching Loss\";\"Secondary Total Loss\";\"Secondary Max Loss 1"
" FET\";\"Primary I RMS\";\"Secondary I RMS\";\"phi\";\"Cr I RMS\"}\t\t\t\t\t"
"\nfid = fopen (csvfilename, \"a\");\nfprintf(fid,'Vin,Vout Target,dp,ds,Power"
"'); \nfor sigList = 1:length(signalList)\n\t%fprintf(fid,',Min %s,Max %s,Mean"
" %s',signalList{sigList},signalList{sigList},signalList{sigList}); \n\tfprint"
"f(fid,',%s',signalList{sigList}); \nend\nfprintf(fid,'\\n');\nfclose (fid);\n"
"\n% Evaluate simulation results in callback function\nfunction result = callb"
"ack(index, data)\n   % Find relevent output values\n   if isstruct(data)\n   "
"\ttempResult = [];\n   \tfor signal = 1:17\n   \t\t%minVal = min(data.Values("
"signal,:));\n   \t\t%maxVal = max(data.Values(signal,:));\n   \t\tmeanVal = m"
"ean(data.Values(signal,:));\n   \t\t%tempResult = [tempResult,minVal,maxVal,m"
"eanVal];\n   \t\ttempResult = [tempResult,meanVal];\n   \tend\n      % Reduci"
"ng simulation results by return value 'result' \n      result = tempResult;\n"
"   else\n      % Print error message to Octave console\n      %printf(' Error"
" in Simulation %d for test=%s: %s\\n',\n      %            index, testName(in"
"dex), data);\n      printf(' Error in Simulation for %d \\n',index);\n   end"
"\nend\n\n% Set value to be swept\nvinValues = [700 800]; \n% voutValues = [25"
"0 300 350]; \nvoutValues = [200 250 300 350 400]; \n%poutValues = [15 150 500"
" 1000 2000 4000 8000 10000 12000 14000 16000 18000]; \npoutValues = [-18000 -"
"16000 -8000 -2000 -1000 -250 -15 15 250 1000 2000 8000 16000 18000]; \n%dpVal"
"ues = [1.0 0.95 0.90 0.85 0.80 0.75 0.70 0.65 0.60 0.55 0.50 0.45 0.40 0.35 0"
".30 0.25 0.20];\n%dsValues = [1.0 0.95 0.90 0.85 0.80 0.75 0.70 0.65 0.60 0.5"
"5 0.50 0.45 0.40 0.35 0.30 0.25 0.20];\ndpValues = [1.0 0.95 0.90 0.85 0.80 0"
".75 0.70 0.65 0.60 0.55 0.50 0.45 0.40 0.35 0.30];\ndsValues = [1.0 0.95 0.90"
" 0.85 0.80 0.75 0.70 0.65 0.60 0.55 0.50 0.45 0.40 0.35 0.30];\n\n% Loop thro"
"ugh vin voltages\nfor ivin = 1:length(vinValues)\n   % Loop through Vout volt"
"ages\n   for ivout = 1:length(voutValues)\n      %plecs('clc')\n   \t% Loop t"
"hrough power out  valuess\n   \tfor ipout = 1:length(poutValues)\n      \t%pl"
"ecs('clc')\n   \t\t% Loop through dp values\n   \t\tfor idp = 1:length(dpValu"
"es)\n   \t\t\t% Loop through ds values\n      \t\t%plecs('clc')\n   \t\t\tisi"
"m = 0;\n   \t\t\tfor ids = 1:length(dsValues)\n   \t\t\t\tisim = isim + 1;\n "
"     \t\t\t% Initialize simStruct as cell array with all values \n      \t\t"
"\tsimStructs{isim}.SolverOpts.OutputTimes = 0.002:0.00001:0.004; % Restict ou"
"tput to start time 0.002s interval 1/10000 end time 0.004s\n      \t\t\tsimSt"
"ructs{isim}.ModelVars.timeSpan = 0.01;\n      \t\t\tsimStructs{isim}.ModelVar"
"s.Vin = vinValues(ivin);\n      \t\t\tsimStructs{isim}.ModelVars.Vout = voutV"
"alues(ivout);\n      \t\t\tsimStructs{isim}.ModelVars.CapVout = voutValues(iv"
"out);\n      \t\t\tsimStructs{isim}.ModelVars.Pout = poutValues(ipout);\n    "
"  \t\t\tsimStructs{isim}.ModelVars.Force = 1;\n      \t\t\tsimStructs{isim}.M"
"odelVars.Dp = dpValues(idp);\n      \t\t\tsimStructs{isim}.ModelVars.Ds = dsV"
"alues(ids);\n      \t\t\tprintf(' Starting Vin=%dV Vout Target =%dV dp =%f ds"
" = %f Power =%dW isim  =%d\\n', \n             \t\tvinValues(ivin), voutValue"
"s(ivout), dpValues(idp), dsValues(ids), poutValues(ipout), isim);\n\n     \t"
"\t\t\t% Name of 'ModelVars' can be assigned for diagnostic purposes  \n      "
"\t\t\tsimStructs{isim}.Name = [setupName 'Vin=' mat2str(vinValues(ivin)) 'V V"
"out=' mat2str(voutValues(ivout)) 'V Dp =' mat2str(dpValues(idp)) ' Ds =' mat2"
"str(dsValues(ids)) ' Power =' mat2str(poutValues(ipout))  ];\n      \t\t\ttes"
"tName{isim} = simStructs{isim}.Name;\n\n   \t\t\tend\n\n   \t\t\t% Start simu"
"lation, return result from callback function into 'out'\n   \t\t\t% Analysis "
"will be moved to callback function to reduce simulation results\n   \t\t\ttic"
"\n   \t\t\tout = plecs('simulate', simStructs, @(index, data) callback(index,"
" data));\n   \t\t\ttoc\n   \t\t\tisim = 0;\n   \t\t\tfor ids = 1:length(dsVal"
"ues)\n   \t\t\t\tisim = isim + 1;\n      \t\t\t% Detect if errors occurred in"
" parallel simulation \n      \t\t\tif ischar(out{isim})\n         \t\t\tprint"
"f(' Error for Vin=%dV Vout Target =%dV dp =%f ds = %f Power =%dW\\n',\n      "
"         \t\t\tvinValues(ivin), voutValues(ivout), dpValues(idp), dsValues(id"
"s), poutValues(ipout));\n      \t\t\t% Output simulation values to console an"
"d spread sheet\n      \t\t\telse\n         \t\t\tfid = fopen (csvfilename, \""
"a\");\n         \t\t\tprintf(' Results for Vin = %dV Vout = %dV dp =%f ds = %"
"f Power =%dW: \\n ', vinValues(ivin),    voutValues(ivout), dpValues(idp), ds"
"Values(ids), poutValues(ipout));\n         \t\t\tfprintf(fid,'%d,%d,%f,%f,%d'"
", vinValues(ivin), voutValues(ivout), dpValues(idp), dsValues(ids), poutValue"
"s(ipout));\n         \t\t\tfor sigList = 1:length(signalList)\n\t\t\t\t\t\t\t"
"%printf('\t%s Min = %f Max = %f Mean = %f\\n',signalList{sigList}, out{isim}("
"((sigList-1)*3)+1), out{isim}(((sigList-1)*3)+2), out{isim}(((sigList-1)*3)+3"
")); \n\t\t\t\t\t\t\tprintf('\t%s = %f \\n',signalList{sigList}, out{isim}(sig"
"List)); \n         \t\t\t\t%fprintf(fid,',%f,%f,%f', out{isim}(((sigList-1)*3"
")+1), out{isim}(((sigList-1)*3)+2), out{isim}(((sigList-1)*3)+3));\n         "
"\t\t\t\tfprintf(fid,',%f', out{isim}(sigList));\n         \t\t\tend\n\t\t\t\t"
"\t\tprintf('End Results\\n'); \n         \t\t\tfprintf(fid,'\\n');\n         "
"\t\t\tfclose (fid);\n         \t\tend\n         \tend\n      \tend\n      end"
"      \t\n   end\nend\n"
  }
}
