  Solver        "auto"
  MaxStep       "1e-3"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "2"
  NegativeSwitchLossMsg "2"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "100000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "Timespan = 1.0;\n\n% DC Supply Parameters\nDCVoltage"
" =400;%input voltage\nDCCurrent =100;%input current limit\nDCImpedence = 0.00"
"00000001;\n\n% set_current = 160; %control feedback\nset_current = 450; %shoc"
"k\nDriveFrequency = 400;\ntdead = 500e-9;\n% check load before simulation\n% "
"set_voltage = 100;\nset_voltage = DCVoltage-80; %shock\n%rload=0.6;\nrload=se"
"t_voltage/set_current;\nlload=10e-6;\ncload=200e-6;\n\n% Snuber Values\nsnubR"
" = 4.7;\nsnubC = 300e-12;\n\n% PWM Parameters\nPWMperiod = 3e-5;\nPWMfs = 1/P"
"WMperiod;\nPWMoffset = PWMperiod/3;\n\n% Capacitor Bank Parameters\nCapBank.C"
"apCount=1;\nCapBank.CperCap=0.018;\nCapBank.C=CapBank.CperCap*CapBank.CapCoun"
"t;\nCapBank.ESRperCap=0.016;\nCapBank.ESR=1/((1/CapBank.ESRperCap)*CapBank.Ca"
"pCount);\nCapBank.Vinitial=DCVoltage;\n\n%Control signals\n%for simulating sh"
"ock pulse lower than or equal to 1mSec chage drive frequency to 10000\n\nDriv"
"eshock_pulse_width = 11e-3;\nDriveshock_freq = 1/(Driveshock_pulse_width*1.25"
");\n%For shock type 1:shockInterval can be any integer above 3 (higher value "
"gives higher gap in multiple of shock width)\n%For shock type 2:shockInterval"
" can be 1,2,3,4,6,8,12 or 24 (lower the value higher the gap between the shoc"
"k pulses)\nshockinterval=24;\n"
